{
	"name": "express-http-context2",
	"version": "1.0.0",
	"description": "Modern request-scoped storage support for Express.js based on Asynchronous Local Storage.",
	"keywords": [
		"asynchronous-local-storage",
		"asynchronouslocalstorage",
		"context",
		"express",
		"express-http-context",
		"express-request-context",
		"http-context",
		"middleware",
		"plugin",
		"request",
		"request-context"
	],
	"homepage": "https://github.com/artberri/express-http-context2#readme",
	"bugs": {
		"url": "https://github.com/artberri/express-http-context2/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Alberto Varela",
		"email": "hello@albertovarela.net",
		"url": "https://www.albertovarela.net"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/artberri/express-http-context2.git"
	},
	"files": [
		"lib",
		"src",
		"CHANGELOG.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./lib/index.cjs",
	"module": "./lib/index.mjs",
	"types": "./lib/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./lib/index.d.mts",
				"default": "./lib/index.mjs"
			},
			"require": {
				"types": "./lib/index.d.cts",
				"default": "./lib/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf lib/ coverage/",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"hook:commit-msg": "commitlint -e",
		"hook:pre-commit": "pnpm run qa",
		"lint": "oxlint --type-aware",
		"prepack": "pnpm run qa && pnpm run build",
		"qa": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
		"test": "node --test 'test/**/*.test.ts'",
		"test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=src/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'test/**/*.test.ts'",
		"test:watch": "node --test --watch 'test/**/*.test.ts'",
		"type-check": "tsc"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/supertest": "^7.2.1",
		"express": "^5.3.0",
		"oxfmt": "^0.77.0",
		"oxlint": "^1.92.0",
		"oxlint-tsgolint": "^7.0.2006",
		"supertest": "^7.3.2",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.18.0"
}
